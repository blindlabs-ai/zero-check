# zero-check NTF1 v1 spec | 0-dep verifier + linter + airlock
NTF1 zero_check

# Core verification + co-evolution pipelines
zero_check |> lint_rs |> abstract_eval |> simd_fuzz |> gauntlet
zero_cc |> ir |> egraph |> codegen |> rust_emit

# Forward morphisms (+t)
+t rust_src |> mask_rust_source -> lint_rs
+t ntf1_spec |> parse_ntf1 -> emit_ntf1
+t ir_dag |> sethi_ullman_su -> schedule_report
+t ir_dag |> interval_congruence_egraph -> abstract_report
+t abstract_report |> branch_and_bound_x8 -> proof_verdict
+t rust_emit -> zero_check
+t zero_check -> Fault.UnsafeBlock
+t zero_check -> Fault.ClampCall
+t zero_check -> Fault.SuppressAttr
+t zero_check -> Fault.RegisterSpill
+t zero_check -> Fault.MemorySafety
+t zero_check -> Fault.SvoGrammarTax

# Retro-causal traps (-t)
-t Fault.UnsafeBlock <- Guard.ForbidUnsafe
-t Fault.ClampCall <- Guard.NoDotOrPathClamp
-t Fault.SuppressAttr <- Guard.NoAllowOrExpectAttr
-t Fault.RegisterSpill <- Guard.DualArchAvx2NeonCliff
-t Fault.MemorySafety <- Guard.ShadowEpochNoAliasInit
-t Fault.SvoGrammarTax <- Guard.Ntf1ZeroSvoLexer

# Symmetric airlock fixed-points (0t)
0t zero_cc >< zero_check
0t parse_ntf1 |> emit_ntf1 >< parse_ntf1
