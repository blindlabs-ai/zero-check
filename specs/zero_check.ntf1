# zero-check NTF1 v1 spec | 0-dep verifier + linter + airlock
NTF1 zero_check

# Core verification + co-evolution pipelines
zero_check |> lint_rs |> rust_fe |> abstract_eval |> simd_fuzz |> gauntlet
zero_cc |> rust_fe |> ir |> egraph |> codegen |> rust_emit

# Forward morphisms (+t)
+t rust_src |> mask_rust_source -> lint_rs
+t rust_src |> parse_rust_programs -> abstract_eval
+t rust_src |> boundary_morphism -> witness_lattice
+t witness_lattice |> callgraph_airlock -> proof_verdict
+t ntf1_spec |> parse_ntf1 -> emit_ntf1
+t ir_dag |> sethi_ullman_su -> schedule_report
+t ir_dag |> interval_congruence_egraph -> abstract_report
+t ir_dag |> relational_diff_bounds -> abstract_report
+t abstract_report |> branch_and_bound_x8 -> proof_verdict
+t proof_verdict |> synthesize_rust_poc -> rust_poc_test
+t rust_emit -> zero_check
+t zero_check -> Fault.UnsafeBlock
+t zero_check -> Fault.ClampCall
+t zero_check -> Fault.SuppressAttr
+t zero_check -> Fault.RegisterSpill
+t zero_check -> Fault.MemorySafety
+t zero_check -> Fault.SvoGrammarTax
+t zero_check -> Fault.KernelPanic
+t zero_check -> Fault.DynSliceOob
+t zero_check -> Fault.ExplicitPanic
+t zero_check -> Fault.AsyncAwaitHavoc
+t zero_check -> Fault.Utf8CharBoundary
+t zero_check -> Fault.LoopCursorOob

# Retro-causal traps (-t)
-t Fault.UnsafeBlock <- Guard.ForbidUnsafe
-t Fault.ClampCall <- Guard.NoDotOrPathClamp
-t Fault.SuppressAttr <- Guard.NoAllowOrExpectAttr
-t Fault.RegisterSpill <- Guard.DualArchAvx2NeonCliff
-t Fault.MemorySafety <- Guard.ShadowEpochNoAliasInit
-t Fault.SvoGrammarTax <- Guard.Ntf1ZeroSvoLexer
-t Fault.KernelPanic <- Guard.ZeroPanicKernelStrict
-t Fault.DynSliceOob <- Guard.RelationalSliceBounds
-t Fault.ExplicitPanic <- Guard.ZeroReachablePanic
-t Fault.AsyncAwaitHavoc <- Guard.AwaitMutHavocAndPollPoc
-t Fault.Utf8CharBoundary <- Guard.CharBoundaryAndAsciiProof
-t Fault.LoopCursorOob <- Guard.BoundedLoopAndStructCursor

# Symmetric airlock fixed-points (0t)
0t zero_cc >< zero_check
0t parse_ntf1 |> emit_ntf1 >< parse_ntf1
0t rust_fe >< abstract_eval
0t witness_lattice >< callgraph_airlock
0t proof_verdict >< rust_poc_test
